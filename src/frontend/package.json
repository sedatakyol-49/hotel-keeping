{
  "name": "hotelcore-web",
  "version": "0.0.0",
  "description": "HotelCore — Angular 22 frontend (standalone, Signals, Tailwind v4, ngx-translate)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve hotelcore-web",
    "start:guest": "ng serve guest-web",
    "build": "node scripts/run-builds.mjs",
    "build:admin": "ng build hotelcore-web",
    "build:guest": "ng build guest-web",
    "build:dev": "node scripts/run-builds.mjs --configuration development",
    "watch": "ng build hotelcore-web --watch --configuration development",
    "serve:guest:ssr": "node dist/guest-web/server/server.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:admin": "ng test hotelcore-web --watch=false",
    "test:guest": "ng test guest-web --watch=false",
    "test:watch": "ng test hotelcore-web --watch=true",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "legal:snapshot": "node scripts/legal-snapshot.mjs",
    "legal:snapshot:check": "node scripts/legal-snapshot.mjs --check",
    "verify:build": "node scripts/verify-build-output.mjs",
    "verify:fonts": "node scripts/verify-fonts.mjs",
    "fonts:vendor": "node scripts/vendor-fonts.mjs",
    "fonts:vendor:check": "node scripts/vendor-fonts.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "ng-openapi-gen --input http://localhost:5080/swagger/v1/swagger.json --output src/app/core/api/generated"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "22.0.8",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.8",
    "@angular/ssr": "22.0.8",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.24",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
